<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">#1A73E8</item>
        <item name="android:colorAccent">#1A73E8</item>
        <item name="android:fontFamily">@font/roboto</item>
    </style>

    <!-- Bàn phím: như theme mặc định của bộ gõ, thêm phông Roboto cho các TextView (HanNomIME.onCreate). -->
    <style name="ImeTheme" parent="@android:style/Theme.DeviceDefault.InputMethod">
        <item name="android:fontFamily">@font/roboto</item>
    </style>

    <!-- Trang cài đặt tự vẽ thanh tiêu đề kiểu Gboard (SettingsUi.kt). -->
    <style name="SettingsTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#3F5A92</item>
        <item name="android:fontFamily">@font/roboto</item>
    </style>

    <!-- Hộp thoại "Thêm mục mới": nền trong suốt, thấy ứng dụng đang dùng phía sau. -->
    <style name="ClipAddTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">#3F5A92</item>
        <item name="android:fontFamily">@font/roboto</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
</resources>
